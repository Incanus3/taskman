<Layouts.app flash={@flash} current_scope={nil}>
  <div
    id="taskman-workspace"
    phx-hook=".TaskDetailLayout"
    class="min-h-screen bg-slate-950 text-slate-100"
  >
    <div class="grid min-h-screen grid-cols-[minmax(0,1fr)] lg:grid-cols-[19rem_minmax(0,1fr)]">
      <aside id="project-sidebar" class="border-r border-slate-800 bg-slate-950 text-slate-100">
        <div class="flex h-full flex-col p-6">
          <div class="mb-5 flex items-center gap-3">
            <div class="grid size-10 place-items-center rounded-xl bg-indigo-500 text-white shadow-lg shadow-indigo-950/30">
              <.icon name="hero-check-circle" class="size-6" />
            </div>
            <div>
              <p class="text-base font-semibold tracking-tight">Taskman</p>
              <p class="text-xs text-slate-400">Local project workspace</p>
            </div>
          </div>

          <WorkspaceNavigation.tree
            navigation_nodes={@streams.navigation_nodes}
            include_children?={@include_children?}
            list_edit={@list_edit}
          />

          <.form
            for={@project_form}
            id="project-form"
            phx-change="validate_project"
            phx-submit="save_project"
            class="mt-auto flex flex-col gap-3 border-t border-white/10 pt-5"
          >
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">
              New Project
            </p>
            <.input
              field={@project_form[:name]}
              type="text"
              label="Name"
              autocomplete="off"
              class="w-full rounded-xl border border-slate-700 bg-slate-900 px-3 py-2.5 text-sm text-white outline-none transition placeholder:text-slate-500 focus:border-indigo-400 focus:ring-4 focus:ring-indigo-400/10"
              error_class="border-rose-400 focus:border-rose-400 focus:ring-rose-400/10"
            />
            <.input
              field={@project_form[:primary_directory]}
              type="text"
              label="Primary directory"
              autocomplete="off"
              class="w-full rounded-xl border border-slate-700 bg-slate-900 px-3 py-2.5 font-mono text-xs text-white outline-none transition placeholder:text-slate-500 focus:border-indigo-400 focus:ring-4 focus:ring-indigo-400/10"
              error_class="border-rose-400 focus:border-rose-400 focus:ring-rose-400/10"
            />
            <button
              type="submit"
              phx-disable-with="Creating…"
              class="w-full rounded-xl bg-indigo-500 px-3 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-400 disabled:cursor-wait disabled:opacity-60"
            >
              Create Project
            </button>
          </.form>
        </div>
      </aside>

      <main
        id="main-panel"
        data-state={main_panel_state(assigns)}
        class="min-w-0 bg-slate-900"
      >
        <div
          :if={!@selected_project && !@project_not_found?}
          class="grid min-h-screen place-items-center px-6 py-16 text-center"
        >
          <div class="max-w-md">
            <.icon name="hero-arrow-left" class="mx-auto mb-5 size-8 text-indigo-500 lg:hidden" />
            <h1 class="text-2xl font-semibold tracking-tight text-slate-100">Choose a Project</h1>
            <p class="mt-3 text-sm leading-6 text-slate-400">
              Select a Project from the sidebar or create one to begin organizing work.
            </p>
          </div>
        </div>

        <section
          :if={@project_not_found?}
          id="project-not-found"
          class="grid min-h-screen place-items-center px-6 py-16 text-center"
        >
          <div class="max-w-md">
            <.icon name="hero-folder-minus" class="mx-auto mb-5 size-10 text-slate-600" />
            <h1 class="text-2xl font-semibold tracking-tight text-slate-100">
              Project not found
            </h1>
            <p class="mt-3 text-sm leading-6 text-slate-400">
              This Project may have been removed. Choose another Project from the sidebar.
            </p>
          </div>
        </section>

        <section
          :if={@location_not_found? && @selected_project}
          id="location-not-found"
          class="grid min-h-screen place-items-center px-6 py-16 text-center"
        >
          <div class="max-w-md">
            <.icon name="hero-list-bullet" class="mx-auto mb-5 size-10 text-slate-600" />
            <h1 class="text-2xl font-semibold tracking-tight text-slate-100">
              List not found
            </h1>
            <p class="mt-3 text-sm leading-6 text-slate-400">
              This List may belong to another Project or may have been removed. Choose another
              location from the sidebar.
            </p>
          </div>
        </section>

        <section
          :if={@selected_project && !@location_not_found?}
          class="p-6"
        >
          <header class="mb-5 flex items-center justify-between gap-4">
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-indigo-300">
                {if(@selected_list, do: "List", else: "Project")}
              </p>
              <h1
                id="location-heading"
                class="mt-1 min-w-0 text-2xl font-semibold tracking-tight text-slate-100"
              >
                <%= if @selected_list do %>
                  <span
                    id="location-path"
                    class="flex min-w-0 items-center gap-2 overflow-hidden"
                  >
                    <%= for {task_list, index} <- Enum.with_index(@location_path) do %>
                      <span :if={index > 0} aria-hidden="true" class="shrink-0 text-slate-600">
                        /
                      </span>
                      <span
                        aria-current={task_list.id == @selected_list.id && "page"}
                        class={[
                          "truncate",
                          task_list.id == @selected_list.id && "text-slate-100",
                          task_list.id != @selected_list.id && "text-slate-400"
                        ]}
                      >
                        {task_list.name}
                      </span>
                    <% end %>
                  </span>
                <% else %>
                  <span class="block truncate">{@selected_project.name}</span>
                <% end %>
              </h1>
            </div>
            <div class="flex shrink-0 items-center gap-3">
              <.link
                id="include-child-lists"
                patch={browse_path(@selected_project, @selected_list, !@include_children?)}
                aria-pressed={to_string(@include_children?)}
                data-state={if(@include_children?, do: "on", else: "off")}
                class={[
                  "inline-flex h-10 items-center gap-2 rounded-xl border px-3 text-xs font-semibold transition",
                  @include_children? &&
                    "border-indigo-400/40 bg-indigo-400/15 text-indigo-100 hover:bg-indigo-400/20",
                  !@include_children? &&
                    "border-slate-700 bg-slate-900/60 text-slate-300 hover:border-slate-600 hover:bg-slate-800 hover:text-white"
                ]}
              >
                <span>Include child Lists</span>
                <span
                  id="include-child-lists-track"
                  aria-hidden="true"
                  class={[
                    "flex h-4 w-8 shrink-0 items-center rounded-full p-0.5 transition-colors",
                    @include_children? && "bg-indigo-400",
                    !@include_children? && "bg-slate-600"
                  ]}
                >
                  <span
                    id="include-child-lists-thumb"
                    class={[
                      "size-3 rounded-full bg-white shadow-sm transition-transform",
                      @include_children? && "translate-x-4",
                      !@include_children? && "translate-x-0"
                    ]}
                  />
                </span>
              </.link>
              <TaskComponents.status_filter
                form={@status_filter_form}
                visible_statuses={@visible_task_statuses}
                open?={@task_status_filter_open?}
              />
              <.link
                id="add-task"
                patch={new_task_path(@selected_project, @selected_list, @include_children?)}
                class="inline-flex h-10 items-center justify-center rounded-xl bg-indigo-600 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500"
              >
                Add task
              </.link>
            </div>
          </header>

          <div class={[
            "rounded-2xl border border-slate-700 bg-slate-900 shadow-sm shadow-black/20 sm:grid sm:gap-x-0.5",
            @include_children? &&
              "sm:grid-cols-[4rem_minmax(0,1fr)_fit-content(35%)_5.5rem_5.5rem_5.75rem]",
            !@include_children? &&
              "sm:grid-cols-[4rem_minmax(0,1fr)_5.5rem_5.5rem_5.75rem]"
          ]}>
            <div
              :if={!@tasks_empty?}
              id="task-table-header"
              class="hidden gap-3 border-b border-slate-700 px-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 sm:col-span-full sm:grid sm:grid-cols-subgrid sm:items-center sm:gap-x-0.5"
            >
              <TaskComponents.sort_header
                id="task-number-header"
                label="#"
                field={:id}
                task_sort={@task_sort}
                class="sm:pl-1"
              />
              <TaskComponents.sort_header
                id="task-title-header"
                label="Task"
                field={:title}
                task_sort={@task_sort}
              />
              <TaskComponents.sort_header
                :if={@include_children?}
                id="task-location-header"
                label="Location"
                field={:location}
                task_sort={@task_sort}
                class="justify-center"
              />
              <TaskComponents.sort_header
                id="task-status-header"
                label="Status"
                field={:status}
                task_sort={@task_sort}
                class="justify-center"
              />
              <TaskComponents.sort_header
                id="task-priority-header"
                label="Priority"
                field={:priority}
                task_sort={@task_sort}
                class="justify-center"
              />
              <span id="task-actions-header" class="sm:justify-self-center">Actions</span>
            </div>
            <div id="tasks" phx-update="stream" class="sm:contents">
              <div
                id="tasks-empty"
                class="hidden px-6 py-16 text-center only:block sm:col-span-full"
              >
                <.icon name="hero-clipboard-document-list" class="mx-auto size-9 text-slate-600" />
                <p class="mt-3 text-sm font-medium text-slate-300">
                  <%= cond do %>
                    <% @tasks_filtered_empty? -> %>
                      No tasks match the selected statuses
                    <% @include_children? && @selected_list -> %>
                      No tasks in this List or its child Lists yet
                    <% @include_children? -> %>
                      No tasks in this Project or its child Lists yet
                    <% @selected_list -> %>
                      No direct tasks in this List yet
                    <% true -> %>
                      No direct tasks yet
                  <% end %>
                </p>
              </div>
              <TaskComponents.row
                :for={{dom_id, task_with_location} <- @streams.tasks}
                id={dom_id}
                task_with_location={task_with_location}
                task_path={
                  task_detail_path(
                    @selected_project,
                    @selected_list,
                    task_with_location.task,
                    @include_children?
                  )
                }
                include_children?={@include_children?}
                task_move={@task_move}
                add_subtask_path={
                  new_task_path(
                    @selected_project,
                    @selected_list,
                    @include_children?,
                    task_with_location.task.id
                  )
                }
              />
            </div>
          </div>
        </section>
      </main>
    </div>

    <.modal
      :if={@live_action == :new_task && @selected_project && !@location_not_found?}
      id="task-modal"
      show
      initial_focus="#task-title"
      on_cancel={JS.patch(browse_path(@selected_project, @selected_list, @include_children?))}
    >
      <h2 id="task-modal-title" class="pr-10 text-xl font-semibold tracking-tight text-slate-100">
        Add task
      </h2>
      <p id="task-create-location" class="mt-2 text-sm leading-6 text-slate-400">
        {task_create_location_copy(@selected_project, @task_create_location)}
      </p>
      <TaskForm.form
        form={@task_create_form}
        mode={:new}
        change="validate_task"
        submit="save_task"
        cancel={browse_path(@selected_project, @selected_list, @include_children?)}
        create_enabled?={@task_create_enabled?}
        parent_picker={@task_parent_picker}
      />
    </.modal>

    <.modal
      :if={
        @live_action == :show_task && @selected_project && !@location_not_found? && @selected_task
      }
      id="task-modal"
      show
      size={:wide}
      initial_focus="#task-title"
      on_cancel={JS.patch(browse_path(@selected_project, @selected_list, @include_children?))}
      on_escape={if(TaskMove.active?(@task_move), do: JS.push("cancel_move_task"), else: nil)}
    >
      <TaskmanWeb.TaskDetail.detail
        task={@selected_task}
        task_autosave={@task_autosave}
        parent_picker={@task_parent_picker}
        cancel={browse_path(@selected_project, @selected_list, @include_children?)}
        task_hierarchy={@task_hierarchy}
        task_path={
          fn task ->
            task_detail_path(
              @selected_project,
              @selected_list,
              task,
              @include_children?
            )
          end
        }
        task_move={@task_move}
      />
    </.modal>

    <.modal
      :if={
        @live_action == :show_task && @selected_project && !@location_not_found? &&
          @task_not_found?
      }
      id="task-modal"
      show
      on_cancel={JS.patch(browse_path(@selected_project, @selected_list, @include_children?))}
    >
      <div id="task-not-found">
        <h2
          id="task-modal-title"
          class="pr-10 text-xl font-semibold tracking-tight text-slate-100"
        >
          Task not found
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          This Task does not belong to the selected Project or may have been removed.
        </p>
        <div class="mt-6 flex justify-end">
          <.link
            id="close-task-not-found"
            patch={browse_path(@selected_project, @selected_list, @include_children?)}
            class="rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-300 transition hover:bg-slate-800 hover:text-white"
          >
            Close
          </.link>
        </div>
      </div>
    </.modal>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".TaskDetailLayout">
      export default {
        mounted() {
          this.hierarchyPreference = null

          this.onWorkspaceClick = event => {
            const toggle = event.target.closest("#task-hierarchy-toggle")

            if (toggle && this.el.contains(toggle)) {
              const expanded = this.currentExpanded()
              this.rememberAndApply(!expanded)
              return
            }

            const overlay = event.target.closest("#task-hierarchy-overlay")

            if (overlay && this.el.contains(overlay) && this.narrowOverlayExpanded()) {
              this.rememberAndApply(false)
            }
          }

          this.onWorkspaceKeydown = event => {
            if (event.key === "Escape" && this.narrowOverlayExpanded()) {
              event.preventDefault()
              event.stopPropagation()
              this.rememberAndApply(false)
            }
          }

          this.el.addEventListener("click", this.onWorkspaceClick)
          this.el.addEventListener("keydown", this.onWorkspaceKeydown)
          this.syncHierarchy()
        },

        updated() {
          this.syncHierarchy()
        },

        destroyed() {
          this.el.removeEventListener("click", this.onWorkspaceClick)
          this.el.removeEventListener("keydown", this.onWorkspaceKeydown)
        },

        layout() {
          return this.el.querySelector("#task-detail-layout")
        },

        currentExpanded() {
          return this.layout()?.dataset.hierarchyExpanded === "true"
        },

        narrowOverlayExpanded() {
          return !window.matchMedia("(min-width: 80rem)").matches && this.currentExpanded()
        },

        rememberAndApply(expanded) {
          this.hierarchyPreference = expanded
          this.applyExpanded(expanded)
        },

        syncHierarchy() {
          const layout = this.layout()
          if (!layout) return

          const contextualDefault = layout.dataset.hasHierarchy === "true"
          this.applyExpanded(this.hierarchyPreference ?? contextualDefault)
        },

        applyExpanded(expanded) {
          const layout = this.layout()
          if (!layout) return

          layout.dataset.hierarchyExpanded = String(expanded)

          const toggle = layout.querySelector("#task-hierarchy-toggle")
          if (!toggle) return

          toggle.setAttribute("aria-expanded", String(expanded))
          toggle.setAttribute(
            "aria-label",
            expanded ? "Collapse task hierarchy" : "Expand task hierarchy"
          )

          layout
            .querySelector("[data-hierarchy-icon='expand']")
            ?.classList.toggle("hidden", expanded)
          layout
            .querySelector("[data-hierarchy-icon='collapse']")
            ?.classList.toggle("hidden", !expanded)
        }
      }
    </script>
  </div>
</Layouts.app>
