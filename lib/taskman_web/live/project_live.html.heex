<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_user={@current_user}
  content_scroll?={false}
>
  <div
    id="taskman-workspace"
    phx-hook=".TaskDetailLayout"
    class="h-full bg-slate-950 text-slate-100"
  >
    <div
      id="workspace-content"
      phx-hook="TaskmanWeb.ProjectLive.TaskTablePreferences"
      data-task-statuses={Enum.map_join(Task.statuses(), ",", &Atom.to_string/1)}
      data-preferences-hydrated={to_string(@preferences_hydrated?)}
      inert={not is_nil(RecoveryWorkflow.view(@recovery))}
      class="h-full"
    >
      <div
        id="project-memory"
        phx-hook="TaskmanWeb.ProjectLive.ProjectMemory"
        data-project-id={@workspace.selected_project && @workspace.selected_project.id}
        data-root-route={to_string(@live_action == :index)}
        data-preferences-hydrated={to_string(@preferences_hydrated?)}
        hidden
      >
      </div>
      <div
        id="workspace-layout"
        class="relative grid h-full min-h-0 grid-cols-[minmax(0,1fr)] overflow-hidden lg:grid-cols-[19rem_minmax(0,1fr)]"
      >
        <button
          :if={@workspace.mobile_sidebar_open?}
          id="project-sidebar-backdrop"
          type="button"
          phx-click="close_mobile_sidebar"
          aria-label="Close Project navigation"
          class="absolute inset-0 z-40 bg-slate-950/60 lg:hidden"
        />
        <aside
          id="project-sidebar"
          phx-hook="TaskmanWeb.ProjectLive.MobileProjectDrawer"
          data-open={to_string(@workspace.mobile_sidebar_open?)}
          phx-window-keydown={@workspace.mobile_sidebar_open? && "close_mobile_sidebar"}
          phx-key="escape"
          class={[
            "absolute inset-y-0 left-0 z-50 w-[min(19rem,calc(100vw-3rem))] min-h-0 overflow-hidden border-r border-slate-800 bg-slate-950 text-slate-100 lg:static lg:block lg:w-auto",
            !@workspace.mobile_sidebar_open? && "hidden"
          ]}
        >
          <div class="flex h-full min-h-0 flex-col p-6">
            <div class="mb-4 flex shrink-0 items-center justify-between lg:hidden">
              <span class="text-sm font-semibold text-slate-200">Projects</span>
              <button
                id="project-sidebar-close"
                type="button"
                phx-click="close_mobile_sidebar"
                aria-label="Close Project navigation"
                data-tooltip=""
                class="grid size-8 place-items-center rounded-lg text-slate-400 transition hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
              >
                <.icon name="hero-x-mark" class="size-5" />
              </button>
            </div>
            <ProjectSelector.selector
              selected_project={@workspace.selected_project}
              projects={@streams.projects}
              projects_empty?={@projects_empty?}
              open?={@workspace.project_selector_open?}
              inert?={not is_nil(RecoveryWorkflow.view(@recovery))}
            />

            <WorkspaceNavigation.tree
              navigation_nodes={@streams.navigation_nodes}
              selected_project={@workspace.selected_project}
              selected_list={@workspace.selected_list}
              location_not_found?={@workspace.location_not_found?}
              include_children?={@workspace.include_children?}
              list_edit={@workspace.list_edit}
            />

            <div class="mt-auto shrink-0 border-t border-white/10 pt-5">
              <button
                id="new-project-button"
                type="button"
                phx-click="open_project_new"
                class="flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-500 px-3 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
              >
                <.icon name="hero-plus" class="size-4" /> New Project
              </button>
            </div>
          </div>
        </aside>

        <main
          id="main-panel"
          data-state={Workspace.panel_state(@workspace)}
          class="flex h-full min-h-0 min-w-0 flex-col overflow-hidden bg-slate-900"
        >
          <div
            id="workspace-mobile-header"
            class="flex shrink-0 items-center border-b border-slate-800 bg-slate-950 px-4 py-2 lg:hidden"
          >
            <button
              id="project-sidebar-toggle"
              type="button"
              phx-click="toggle_mobile_sidebar"
              aria-controls="project-sidebar"
              aria-expanded={to_string(@workspace.mobile_sidebar_open?)}
              class="inline-flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm font-semibold text-slate-200 transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
            >
              <.icon name="hero-bars-3" class="size-5" /> Projects
            </button>
          </div>
          <div
            :if={!@workspace.selected_project && !@workspace.project_not_found?}
            class="grid min-h-0 flex-1 place-items-center px-6 py-16 text-center"
          >
            <div class="max-w-md">
              <.icon name="hero-arrow-left" class="mx-auto mb-5 size-8 text-indigo-500 lg:hidden" />
              <h1 class="text-2xl font-semibold tracking-tight text-slate-100">
                Choose a Project
              </h1>
              <p class="mt-3 text-sm leading-6 text-slate-400">
                Select a Project from the sidebar or create one to begin organizing work.
              </p>
            </div>
          </div>

          <section
            :if={@workspace.project_not_found?}
            id="project-not-found"
            class="grid min-h-0 flex-1 place-items-center px-6 py-16 text-center"
          >
            <div class="max-w-md">
              <.icon name="hero-folder-minus" class="mx-auto mb-5 size-10 text-slate-600" />
              <h1 class="text-2xl font-semibold tracking-tight text-slate-100">
                Project not found
              </h1>
              <p class="mt-3 text-sm leading-6 text-slate-400">
                This Project may have been removed. Choose another Project from the sidebar.
              </p>
            </div>
          </section>

          <section
            :if={@workspace.location_not_found? && @workspace.selected_project}
            id="location-not-found"
            class="grid min-h-0 flex-1 place-items-center px-6 py-16 text-center"
          >
            <div class="max-w-md">
              <.icon name="hero-list-bullet" class="mx-auto mb-5 size-10 text-slate-600" />
              <h1 class="text-2xl font-semibold tracking-tight text-slate-100">
                List not found
              </h1>
              <p class="mt-3 text-sm leading-6 text-slate-400">
                This List may belong to another Project or may have been removed. Choose another
                location from the sidebar.
              </p>
            </div>
          </section>

          <section
            :if={@workspace.selected_project && !@workspace.location_not_found?}
            class="flex min-h-0 flex-1 flex-col p-6"
          >
            <header class="mb-5 flex shrink-0 flex-col items-stretch gap-4 lg:flex-row lg:items-center lg:justify-between">
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-indigo-300">
                  {if(@workspace.selected_list, do: "List", else: "Project")}
                </p>
                <h1
                  id="location-heading"
                  class="mt-1 min-w-0 text-2xl font-semibold tracking-tight text-slate-100"
                >
                  <%= if @workspace.selected_list do %>
                    <span
                      id="location-path"
                      class="flex min-w-0 items-center gap-2 overflow-hidden"
                    >
                      <%= for {task_list, index} <- Enum.with_index(@workspace.location_path) do %>
                        <span :if={index > 0} aria-hidden="true" class="shrink-0 text-slate-600">
                          /
                        </span>
                        <span
                          aria-current={task_list.id == @workspace.selected_list.id && "page"}
                          class={[
                            "truncate",
                            task_list.id == @workspace.selected_list.id && "text-slate-100",
                            task_list.id != @workspace.selected_list.id && "text-slate-400"
                          ]}
                        >
                          {task_list.name}
                        </span>
                      <% end %>
                    </span>
                  <% else %>
                    <span class="block truncate">{@workspace.selected_project.name}</span>
                  <% end %>
                </h1>
              </div>
              <div class="flex min-w-0 flex-wrap items-center gap-2 lg:shrink-0 lg:gap-3">
                <ShareTaskView.control
                  id="share-task-view"
                  include_children?={@workspace.include_children?}
                  visible_statuses={@listing.visible_statuses}
                  hydrated?={@preferences_hydrated?}
                />
                <button
                  id="include-child-lists"
                  type="button"
                  phx-click="toggle_include_children"
                  aria-pressed={to_string(@workspace.include_children?)}
                  data-state={if(@workspace.include_children?, do: "on", else: "off")}
                  class={[
                    "inline-flex h-10 items-center gap-2 rounded-xl border px-3 text-xs font-semibold transition",
                    @workspace.include_children? &&
                      "border-indigo-400/40 bg-indigo-400/15 text-indigo-100 hover:bg-indigo-400/20",
                    !@workspace.include_children? &&
                      "border-slate-700 bg-slate-900/60 text-slate-300 hover:border-slate-600 hover:bg-slate-800 hover:text-white"
                  ]}
                >
                  <span>Include child Lists</span>
                  <span
                    id="include-child-lists-track"
                    aria-hidden="true"
                    class={[
                      "flex h-4 w-8 shrink-0 items-center rounded-full p-0.5 transition-colors",
                      @workspace.include_children? && "bg-indigo-400",
                      !@workspace.include_children? && "bg-slate-600"
                    ]}
                  >
                    <span
                      id="include-child-lists-thumb"
                      class={[
                        "size-3 rounded-full bg-white shadow-sm transition-transform",
                        @workspace.include_children? && "translate-x-4",
                        !@workspace.include_children? && "translate-x-0"
                      ]}
                    />
                  </span>
                </button>
                <Table.status_filter
                  form={@listing.status_filter_form}
                  visible_statuses={@listing.visible_statuses}
                  open?={@listing.filter_open?}
                />
                <.link
                  :if={is_nil(@recovery.snapshot)}
                  id="add-task"
                  patch={
                    Paths.new_task_path(
                      @workspace.selected_project,
                      @workspace.selected_list,
                      @workspace.include_children?
                    )
                  }
                  class="inline-flex h-10 items-center justify-center rounded-xl bg-indigo-600 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500"
                >
                  Add task
                </.link>
              </div>
            </header>

            <div
              id="task-list-scroll"
              class={[
                "min-h-0 flex-1 overflow-y-auto rounded-2xl border border-slate-700 bg-slate-900 shadow-sm shadow-black/20 sm:grid sm:content-start sm:gap-x-0.5",
                @workspace.include_children? &&
                  "sm:grid-cols-[4rem_minmax(0,1fr)_fit-content(35%)_5.5rem_5.5rem_5.75rem]",
                !@workspace.include_children? &&
                  "sm:grid-cols-[4rem_minmax(0,1fr)_5.5rem_5.5rem_5.75rem]"
              ]}
            >
              <div
                :if={!@listing.tasks_empty?}
                id="task-table-header"
                class="sticky top-0 z-20 hidden gap-3 border-b border-slate-700 bg-slate-900 px-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 sm:col-span-full sm:grid sm:grid-cols-subgrid sm:items-center sm:gap-x-0.5"
              >
                <Table.sort_header
                  id="task-number-header"
                  label="#"
                  field={:id}
                  task_sort={@listing.sort}
                  class="sm:pl-1"
                />
                <Table.sort_header
                  id="task-title-header"
                  label="Task"
                  field={:title}
                  task_sort={@listing.sort}
                />
                <Table.sort_header
                  :if={@workspace.include_children?}
                  id="task-location-header"
                  label="Location"
                  field={:location}
                  task_sort={@listing.sort}
                  class="justify-center"
                />
                <Table.sort_header
                  id="task-status-header"
                  label="Status"
                  field={:status}
                  task_sort={@listing.sort}
                  class="justify-center"
                />
                <Table.sort_header
                  id="task-priority-header"
                  label="Priority"
                  field={:priority}
                  task_sort={@listing.sort}
                  class="justify-center"
                />
                <span id="task-actions-header" class="sm:justify-self-center">Actions</span>
              </div>
              <div id="tasks" phx-update="stream" class="sm:contents">
                <div
                  id="tasks-empty"
                  class="hidden px-6 py-16 text-center only:block sm:col-span-full"
                >
                  <.icon
                    name="hero-clipboard-document-list"
                    class="mx-auto size-9 text-slate-600"
                  />
                  <p class="mt-3 text-sm font-medium text-slate-300">
                    <%= cond do %>
                      <% @listing.tasks_filtered_empty? -> %>
                        No tasks match the selected statuses
                      <% @workspace.include_children? && @workspace.selected_list -> %>
                        No tasks in this List or its child Lists yet
                      <% @workspace.include_children? -> %>
                        No tasks in this Project or its child Lists yet
                      <% @workspace.selected_list -> %>
                        No direct tasks in this List yet
                      <% true -> %>
                        No direct tasks yet
                    <% end %>
                  </p>
                </div>
                <Table.row
                  :for={{dom_id, task_with_location} <- @streams.tasks}
                  id={dom_id}
                  task_with_location={task_with_location}
                  task_path={
                    Paths.task_detail_path(
                      @workspace.selected_project,
                      @workspace.selected_list,
                      task_with_location.task,
                      @workspace.include_children?
                    )
                  }
                  include_children?={@workspace.include_children?}
                  task_move={@task_move}
                  actions_enabled?={is_nil(@recovery.snapshot)}
                  add_subtask_path={
                    Paths.new_task_path(
                      @workspace.selected_project,
                      @workspace.selected_list,
                      @workspace.include_children?,
                      task_with_location.task.id
                    )
                  }
                />
              </div>
            </div>
          </section>
        </main>
      </div>
    </div>

    <ProjectSelector.editor
      edit={@workspace.project_edit}
      inert?={not is_nil(RecoveryWorkflow.view(@recovery))}
    />

    <div
      :if={RecoveryWorkflow.view(@recovery)}
      id="task-modal"
      class="relative z-50"
      phx-mounted={JS.focus(to: "#task-modal-content")}
    >
      <div
        id="task-modal-backdrop"
        class="fixed inset-0 bg-slate-950/45 backdrop-blur-[2px]"
        aria-hidden="true"
      />
      <div class="fixed inset-0 overflow-y-auto" role="presentation">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-6">
          <div
            id="task-modal-content"
            data-size="wide"
            class={[
              "relative w-full overflow-hidden rounded-2xl border border-slate-700 bg-slate-900 text-left align-middle shadow-2xl shadow-black/50",
              "max-h-[calc(100dvh-2rem)] max-w-7xl sm:max-h-[calc(100dvh-3rem)]"
            ]}
            aria-labelledby="task-recovery-title"
            role="dialog"
            aria-modal="true"
            tabindex="-1"
          >
            <Recovery.shell view={RecoveryWorkflow.view(@recovery)} />
          </div>
        </div>
      </div>
    </div>

    <.modal
      :if={
        is_nil(@recovery.snapshot) && @live_action == :new_task && @workspace.selected_project &&
          @creation.form
      }
      id="task-modal"
      show
      focus_on_mount={false}
      on_cancel={JS.patch(Creation.cancel_path(@workspace))}
    >
      <h2 id="task-modal-title" class="pr-10 text-xl font-semibold tracking-tight text-slate-100">
        Add task
      </h2>
      <Form.form
        form={@creation.form}
        mode={:new}
        change="validate_task"
        submit="save_task"
        cancel={Creation.cancel_path(@workspace)}
        create_enabled?={@creation.enabled?}
        location={@creation.location}
        location_label={@creation.location_label}
        location_options={@creation.location_options}
        location_error={@creation.location_error}
        parent_picker={@task_parent_picker}
      />
    </.modal>

    <.modal
      :if={
        is_nil(@recovery.snapshot) && @live_action == :show_task && @workspace.selected_project &&
          !@workspace.location_not_found? && @editing.selected_task
      }
      id="task-modal"
      show
      size={:wide}
      focus_on_mount={false}
      on_cancel={
        JS.patch(
          Paths.browse_path(
            @workspace.selected_project,
            @workspace.selected_list,
            @workspace.include_children?
          )
        )
      }
      on_escape={if(Move.active?(@task_move), do: JS.push("cancel_move_task"), else: nil)}
    >
      <Detail.detail
        task={@editing.selected_task}
        project={@workspace.selected_project}
        task_autosave={@editing.autosave}
        parent_picker={@task_parent_picker}
        cancel={
          Paths.browse_path(
            @workspace.selected_project,
            @workspace.selected_list,
            @workspace.include_children?
          )
        }
        task_hierarchy={@editing.hierarchy}
        task_path={
          fn task ->
            Paths.task_detail_path(
              @workspace.selected_project,
              @workspace.selected_list,
              task,
              @workspace.include_children?
            )
          end
        }
        browse_path={
          fn task_list ->
            Paths.browse_path(
              @workspace.selected_project,
              task_list,
              @workspace.include_children?
            )
          end
        }
        task_move={@task_move}
      >
        <:header_actions>
          <ShareTaskView.control
            id="task-modal-share-task-view"
            label="Share Task"
            share_path={
              Paths.task_detail_path(
                @workspace.selected_project,
                @workspace.selected_list,
                @editing.selected_task,
                @workspace.include_children?
              )
            }
            include_children?={@workspace.include_children?}
            visible_statuses={@listing.visible_statuses}
            hydrated?={@preferences_hydrated?}
          />
        </:header_actions>
      </Detail.detail>
    </.modal>

    <.modal
      :if={
        is_nil(@recovery.snapshot) && @live_action == :show_task && @workspace.selected_project &&
          !@workspace.location_not_found? &&
          @editing.not_found?
      }
      id="task-modal"
      show
      on_cancel={
        JS.patch(
          Paths.browse_path(
            @workspace.selected_project,
            @workspace.selected_list,
            @workspace.include_children?
          )
        )
      }
    >
      <div id="task-not-found">
        <h2
          id="task-modal-title"
          class="pr-10 text-xl font-semibold tracking-tight text-slate-100"
        >
          Task not found
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          This Task does not belong to the selected Project or may have been removed.
        </p>
        <div class="mt-6 flex justify-end">
          <.link
            id="close-task-not-found"
            patch={
              Paths.browse_path(
                @workspace.selected_project,
                @workspace.selected_list,
                @workspace.include_children?
              )
            }
            class="rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-300 transition hover:bg-slate-800 hover:text-white"
          >
            Close
          </.link>
        </div>
      </div>
    </.modal>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".TaskDetailLayout">
      export default {
        mounted() {
          this.hierarchyPreference = null

          this.onWorkspaceClick = event => {
            const toggle = event.target.closest("#task-hierarchy-toggle")

            if (toggle && this.el.contains(toggle)) {
              const expanded = this.currentExpanded()
              this.rememberAndApply(!expanded)
              return
            }

            const overlay = event.target.closest("#task-hierarchy-overlay")

            if (overlay && this.el.contains(overlay) && this.narrowOverlayExpanded()) {
              this.rememberAndApply(false)
            }
          }

          this.onWorkspaceKeydown = event => {
            if (event.key === "Escape" && this.narrowOverlayExpanded()) {
              event.preventDefault()
              event.stopPropagation()
              this.rememberAndApply(false)
            }
          }

          this.el.addEventListener("click", this.onWorkspaceClick)
          this.el.addEventListener("keydown", this.onWorkspaceKeydown)
          this.syncHierarchy()
        },

        updated() {
          this.syncHierarchy()
        },

        destroyed() {
          this.el.removeEventListener("click", this.onWorkspaceClick)
          this.el.removeEventListener("keydown", this.onWorkspaceKeydown)
        },

        layout() {
          return this.el.querySelector("#task-detail-layout")
        },

        currentExpanded() {
          return this.layout()?.dataset.hierarchyExpanded === "true"
        },

        narrowOverlayExpanded() {
          return !window.matchMedia("(min-width: 48rem)").matches && this.currentExpanded()
        },

        rememberAndApply(expanded) {
          this.hierarchyPreference = expanded
          this.applyExpanded(expanded)
        },

        syncHierarchy() {
          const layout = this.layout()
          if (!layout) return

          const contextualDefault = layout.dataset.hasHierarchy === "true"
          this.applyExpanded(this.hierarchyPreference ?? contextualDefault)
        },

        applyExpanded(expanded) {
          const layout = this.layout()
          if (!layout) return

          layout.dataset.hierarchyExpanded = String(expanded)

          const toggle = layout.querySelector("#task-hierarchy-toggle")
          if (!toggle) return

          toggle.setAttribute("aria-expanded", String(expanded))
          toggle.setAttribute(
            "aria-label",
            expanded ? "Collapse task hierarchy" : "Expand task hierarchy"
          )

          layout
            .querySelector("[data-hierarchy-icon='expand']")
            ?.classList.toggle("hidden", expanded)
          layout
            .querySelector("[data-hierarchy-icon='collapse']")
            ?.classList.toggle("hidden", !expanded)
        }
      }
    </script>
  </div>
</Layouts.app>
