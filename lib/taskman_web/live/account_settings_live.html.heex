<Layouts.app flash={@flash} current_scope={@current_scope} current_user={@current_user}>
  <main id="account-settings" class="min-h-screen bg-slate-950 px-4 py-10 text-slate-100 sm:px-6">
    <div class="mx-auto max-w-3xl space-y-6">
      <header class="space-y-2">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-300">Account</p>
        <h1 class="text-3xl font-semibold tracking-tight">Settings</h1>
        <p class="text-sm leading-6 text-slate-400">
          Manage your sign-in details and access tokens.
        </p>
      </header>

      <.settings_section
        id="email-settings"
        title="Email address"
        description="Your current address remains active until the new one is confirmed."
      >
        <.form
          for={@email_form}
          id="email-change-form"
          phx-submit="request_email_change"
          class="space-y-3"
        >
          <.input field={@email_form[:email]} type="email" label="New email address" required />
          <.input
            field={@email_form[:current_password]}
            type="password"
            label="Current password"
            autocomplete="current-password"
            required
          />
          <button
            type="submit"
            class="rounded-lg bg-indigo-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-400"
          >
            Request email change
          </button>
        </.form>
      </.settings_section>

      <.settings_section
        id="password-settings"
        title="Password"
        description="Changing your password signs out every other browser session."
      >
        <.form
          for={@password_form}
          id="password-change-form"
          action={~p"/account/settings/password"}
          method="post"
          class="space-y-3"
        >
          <.input
            field={@password_form[:current_password]}
            type="password"
            label="Current password"
            autocomplete="current-password"
            required
          />
          <.input
            field={@password_form[:password]}
            type="password"
            label="New password"
            autocomplete="new-password"
            required
          />
          <.input
            field={@password_form[:password_confirmation]}
            type="password"
            label="Confirm new password"
            autocomplete="new-password"
            required
          />
          <button
            type="submit"
            class="rounded-lg bg-indigo-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-400"
          >
            Update password
          </button>
        </.form>
      </.settings_section>

      <.settings_section
        id="session-settings"
        title="Browser sessions"
        description="Revoke sessions you no longer recognize."
      >
        <button
          id="revoke-other-sessions"
          type="button"
          phx-click="revoke-other-sessions"
          class="mb-4 rounded-lg border border-slate-600 px-4 py-2 text-sm font-semibold text-slate-200 transition hover:border-slate-400 hover:text-white"
        >
          Revoke other sessions
        </button>
        <div id="sessions" phx-update="stream" class="space-y-3">
          <p id="sessions-empty" class="hidden text-sm text-slate-400 only:block">
            No stored sessions.
          </p>
          <div
            :for={{dom_id, session} <- @streams.sessions}
            id={dom_id}
            class="flex items-center justify-between gap-4 rounded-xl border border-slate-700 px-4 py-3"
          >
            <div>
              <p class="text-sm font-medium text-slate-100">
                {if(session.current?, do: "Current session", else: "Stored session")}
              </p>
              <p class="text-xs text-slate-400">
                Expires {Calendar.strftime(session.expires_at, "%Y-%m-%d")}
              </p>
            </div>
            <button
              type="button"
              data-action="revoke-session"
              phx-click="revoke-session"
              phx-value-jti={session.jti}
              class="rounded-lg border border-slate-600 px-3 py-1.5 text-sm font-semibold text-slate-200 transition hover:border-rose-400 hover:text-rose-200"
            >
              Revoke
            </button>
          </div>
        </div>
      </.settings_section>

      <.settings_section
        id="api-key-settings"
        title="API keys"
        description="Keys can be used by the Taskman CLI and other automation."
      >
        <.form
          for={@api_key_form}
          id="api-key-form"
          phx-submit="create-api-key"
          class="grid gap-3 sm:grid-cols-[1fr_12rem_auto] sm:items-end"
        >
          <.input field={@api_key_form[:name]} type="text" label="Key name" required />
          <.input
            field={@api_key_form[:expires_in_days]}
            type="number"
            label="Expires in days"
            min="1"
            max="365"
            required
          />
          <button
            type="submit"
            class="rounded-lg bg-indigo-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-400"
          >
            Create key
          </button>
        </.form>

        <div
          :if={@plaintext_api_key}
          id="api-key-plaintext"
          phx-hook=".CopyApiKey"
          phx-update="ignore"
          class="mt-5 rounded-xl border border-amber-400/40 bg-amber-400/10 p-4"
        >
          <p class="text-sm font-semibold text-amber-100">
            Copy this key now. Taskman cannot show it again.
          </p>
          <div class="mt-3 flex gap-2">
            <.input
              id="api-key-plaintext-value"
              name="api_key_plaintext"
              type="text"
              value={@plaintext_api_key}
              readonly
              class="min-w-0 flex-1 font-mono text-xs"
            />
            <button
              id="api-key-copy"
              type="button"
              data-copy-value={@plaintext_api_key}
              class="rounded-lg border border-amber-300/50 px-3 py-2 text-sm font-semibold text-amber-50 transition hover:bg-amber-300/10"
            >Copy</button>
          </div>
          <p id="api-key-copy-status" class="mt-2 text-xs text-amber-100" aria-live="polite"></p>
        </div>

        <script :type={Phoenix.LiveView.ColocatedHook} name=".CopyApiKey">
          export default {
            mounted() {
              const button = this.el.querySelector("#api-key-copy")
              const status = this.el.querySelector("#api-key-copy-status")

              button.addEventListener("click", async () => {
                try {
                  await navigator.clipboard.writeText(button.dataset.copyValue)
                  status.textContent = "Copied"
                } catch (_error) {
                  status.textContent = "Copy the key manually"
                }
              })
            }
          }
        </script>

        <div id="api-keys" phx-update="stream" class="mt-5 space-y-3">
          <p id="api-keys-empty" class="hidden text-sm text-slate-400 only:block">
            No API keys yet.
          </p>
          <div
            :for={{dom_id, api_key} <- @streams.api_keys}
            id={dom_id}
            class="flex items-center justify-between gap-4 rounded-xl border border-slate-700 px-4 py-3"
          >
            <div>
              <p class="text-sm font-medium text-slate-100">{api_key.name}</p>
              <p class="text-xs text-slate-400">
                Expires {Calendar.strftime(api_key.expires_at, "%Y-%m-%d")}
              </p>
            </div>
            <button
              :if={is_nil(api_key.revoked_at)}
              type="button"
              data-action="revoke-api-key"
              phx-click="revoke-api-key"
              phx-value-id={api_key.id}
              class="rounded-lg border border-slate-600 px-3 py-1.5 text-sm font-semibold text-slate-200 transition hover:border-rose-400 hover:text-rose-200"
            >
              Revoke
            </button>
            <span :if={api_key.revoked_at} class="text-sm font-medium text-slate-500">Revoked</span>
          </div>
        </div>
      </.settings_section>

      <.settings_section
        id="danger-zone"
        title="Danger zone"
        description="Deleting your account is permanent and cannot be undone."
        danger?
      >
        <.form
          for={@delete_account_form}
          id="delete-account-form"
          action={~p"/account/settings/delete"}
          method="post"
          class="space-y-3"
        >
          <.input
            field={@delete_account_form[:current_password]}
            type="password"
            label="Current password"
            autocomplete="current-password"
            required
          />
          <.input
            field={@delete_account_form[:confirmation]}
            type="text"
            label="Type DELETE to confirm"
            required
          />
          <button
            type="submit"
            class="rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-500"
          >
            Permanently delete account
          </button>
        </.form>
      </.settings_section>
    </div>
  </main>
</Layouts.app>
