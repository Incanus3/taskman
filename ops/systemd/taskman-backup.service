[Unit]
Description=Taskman validated local PostgreSQL backup
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/taskman/taskman-backup.env
ExecStart=/usr/local/lib/taskman/taskman-backup --database-host ${TASKMAN_BACKUP_DATABASE_HOST} --database-port ${TASKMAN_BACKUP_DATABASE_PORT} --database-role ${TASKMAN_BACKUP_DATABASE_ROLE} --database-name ${TASKMAN_BACKUP_DATABASE_NAME} --backup-root ${TASKMAN_BACKUP_ROOT} --deployment-root ${TASKMAN_DEPLOYMENT_ROOT} --managed-root ${TASKMAN_MANAGED_ROOT} --release-root ${TASKMAN_RELEASE_ROOT} --retention ${TASKMAN_BACKUP_RETENTION} --reason scheduled
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=taskman-backup

# The backup command needs only its protected password file, PostgreSQL over
# loopback, and its explicitly writable durable state roots.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths={{TASKMAN_BACKUP_ROOT}} {{TASKMAN_DEPLOYMENT_ROOT}} /var/lock/taskman
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
