#!/bin/sh

set -eu

if [ "$#" -ne 2 ] && [ "$#" -ne 3 ]; then
  echo "usage: render-caddyfile HOSTNAME CADDYFILE_TEMPLATE [APPLICATION_PORT]" >&2
  exit 64
fi

hostname=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
template=$2
port=${3-4000}

invalid_hostname() {
  echo "render-caddyfile: enter a valid public DNS hostname, not a reserved example name" >&2
  exit 64
}

if [ "${#hostname}" -gt 253 ]; then
  invalid_hostname
fi

if [ ! -f "$template" ] || [ ! -r "$template" ]; then
  echo "render-caddyfile: template is unavailable" >&2
  exit 66
fi

case "$port" in
  ""|*[!0-9]*|0*)
    echo "render-caddyfile: application port is invalid" >&2
    exit 64
    ;;
esac

if [ "$port" -gt 65535 ]; then
  echo "render-caddyfile: application port is invalid" >&2
  exit 64
fi

case "$hostname" in
  ""|.*|*.|*..*|*[!a-z0-9.-]*)
    invalid_hostname
    ;;
  localhost|*.localhost|test|*.test|invalid|*.invalid|example|*.example)
    invalid_hostname
    ;;
  example.com|*.example.com|example.net|*.example.net|example.org|*.example.org)
    invalid_hostname
    ;;
  local|*.local|home.arpa|*.home.arpa|onion|*.onion)
    invalid_hostname
    ;;
  *.*)
    ;;
  *)
    invalid_hostname
    ;;
esac

previous_ifs=$IFS
IFS=.
set -f
set -- $hostname
IFS=$previous_ifs

for label do
  if [ "${#label}" -gt 63 ]; then
    invalid_hostname
  fi

  case "$label" in
    ""|-*|*-)
      invalid_hostname
      ;;
  esac

  last_label=$label
done

case "$last_label" in
  *[a-z]*)
    ;;
  *)
    invalid_hostname
    ;;
esac

marker_count=$(grep -Fxc 'taskman.example.com {' "$template" || true)
port_marker_count=$(grep -Fc 'reverse_proxy 127.0.0.1:{{TASKMAN_APPLICATION_PORT}}' "$template" || true)

if [ "$marker_count" -ne 1 ] || [ "$port_marker_count" -ne 1 ]; then
  echo "render-caddyfile: expected exactly one taskman.example.com site" >&2
  exit 65
fi

sed -e "s/^taskman\\.example\\.com {/${hostname} {/" -e "s/{{TASKMAN_APPLICATION_PORT}}/${port}/" "$template"
