# syntax=docker/dockerfile:1.7
FROM ubuntu@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b AS build

ARG DEBIAN_FRONTEND=noninteractive
ARG SOURCE_REVISION
ARG HEX_VERSION=2.5.1
ARG REBAR3_VERSION=3.24.0
ARG REBAR3_SHA512=158473850233093e6a1417e9779919cb6768402ea967db510d926bc5e74361377e9176014e827c622098e0dbf96b505677addc4bd4817ce2b9b4f4bc8121768b

ENV LANG=C.UTF-8 \
    MIX_ENV=prod

RUN apt-get update \
 && apt-get install --yes --no-install-recommends \
      ca-certificates \
      build-essential \
      git \
      erlang-base=1:27.3.4.6+dfsg-1 \
      erlang-dev=1:27.3.4.6+dfsg-1 \
      erlang-xmerl=1:27.3.4.6+dfsg-1 \
      elixir=1.18.3.dfsg-1build1 \
      nodejs=22.22.1+dfsg+~cs22.19.15-1ubuntu1 \
      npm=9.2.0~ds3-1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN test -n "$SOURCE_REVISION" \
 && mix local.hex "$HEX_VERSION" --force \
 && mix local.rebar rebar3 "https://builds.hex.pm/installs/1.18.3/rebar3-$REBAR3_VERSION-otp-27" --sha512 "$REBAR3_SHA512" --force \
 && mix deps.get --only prod \
 && mix compile --warnings-as-errors \
 && mix assets.deploy \
 && mix release --overwrite

RUN test "$(mix hex.info | sed -n 's/^Hex:[[:space:]]*//p')" = "$HEX_VERSION" \
 && mkdir -p /artifact \
 && cp -a /app/_build/prod/rel/taskman /artifact/taskman \
 && printf '{"source_revision":"%s","target_os":"ubuntu26.04","architecture":"amd64","otp_version":"27.3.4.6","elixir_version":"1.18.3","node_version":"22.22.1","hex_version":"%s","rebar3_version":"%s"}\n' "$SOURCE_REVISION" "$HEX_VERSION" "$REBAR3_VERSION" \
      > /artifact/toolchain.json

FROM scratch AS artifact
COPY --from=build /artifact/ /
