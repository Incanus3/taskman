# syntax=docker/dockerfile:1.7
FROM ubuntu:resolute-20261024.1@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c AS build

ARG DEBIAN_FRONTEND=noninteractive
ARG SOURCE_REVISION
ARG OTP_VERSION=29.1.2
ARG OTP_SHA256=28e1e5c9ae377caff245062bc7d32a536002e2714794ae1de5ccd9f160ad0da8
ARG ELIXIR_VERSION=1.20.5
ARG ELIXIR_SHA256=f424d6f0bb710a1d4898f2645d8ad6cab3f5eab8d71848c0dda2579d3a8e8a06
ARG HEX_VERSION=2.6.0
ARG REBAR3_VERSION=3.28.0
ARG REBAR3_SHA512=55e276f526985dd2279e01247031c0d75715df77c0e9c3317b0564acfc3e1b2be4716edbc37762df943487e8f9c2c99e8db6db82107b4b033dfffd16b45e187b

ENV LANG=C.UTF-8 \
    MIX_ENV=prod

RUN apt-get update \
 && apt-get install --yes --no-install-recommends \
      ca-certificates \
      build-essential \
      curl \
      git \
      libc6 \
      libgcc-s1 \
      libssl3t64 \
      libstdc++6 \
      libtinfo6 \
      nodejs=22.22.1+dfsg+~cs22.19.15-1ubuntu1 \
      npm=9.2.0~ds3-1 \
      unzip \
      zlib1g \
 && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --silent --show-error \
      "https://builds.hex.pm/builds/otp/amd64/ubuntu-26.04/OTP-${OTP_VERSION}.tar.gz" \
      --output /tmp/otp.tar.gz \
 && echo "${OTP_SHA256}  /tmp/otp.tar.gz" | sha256sum --check --strict \
 && tar --extract --gzip --file /tmp/otp.tar.gz --directory /tmp \
 && mkdir --parents /opt/taskman-runtime \
 && mv /tmp/OTP-${OTP_VERSION} /opt/taskman-runtime/otp \
 && /opt/taskman-runtime/otp/Install -minimal /opt/taskman-runtime/otp \
 && curl --fail --location --silent --show-error \
      "https://builds.hex.pm/builds/elixir/v${ELIXIR_VERSION}-otp-29.zip" \
      --output /tmp/elixir.zip \
 && echo "${ELIXIR_SHA256}  /tmp/elixir.zip" | sha256sum --check --strict \
 && mkdir --parents /opt/taskman-runtime/elixir \
 && unzip -q /tmp/elixir.zip -d /opt/taskman-runtime/elixir

ENV PATH=/opt/taskman-runtime/elixir/bin:/opt/taskman-runtime/otp/bin:${PATH}

WORKDIR /app
COPY . .

RUN test -n "$SOURCE_REVISION" \
 && mix local.hex "$HEX_VERSION" --force \
 && mix local.rebar rebar3 "https://builds.hex.pm/installs/1.18.3/rebar3-$REBAR3_VERSION-otp-27" --sha512 "$REBAR3_SHA512" --force \
 && mix deps.get --only prod \
 && mix compile --warnings-as-errors \
 && mix assets.deploy \
 && mix release --overwrite

RUN --network=none \
    timeout --kill-after=5s 30s env \
      RELEASE_TMP=/tmp/taskman-release-boot-check \
      DATABASE_URL=ecto://taskman:build@127.0.0.1:5432/taskman_build \
      SECRET_KEY_BASE="$(printf '%064d' 0)" \
      ASH_AUTHENTICATION_TOKEN_SIGNING_SECRET="$(printf '%064d' 1)" \
      PHX_HOST=build.example.test \
      RESEND_API_KEY=build-resend-key \
      MAIL_FROM=build@example.test \
      /app/_build/prod/rel/taskman/bin/taskman eval ':ok'

RUN test "$(mix hex.info | sed -n 's/^Hex:[[:space:]]*//p')" = "$HEX_VERSION" \
 && mkdir -p /artifact \
 && cp -a /app/_build/prod/rel/taskman /artifact/taskman \
 && printf '{"source_revision":"%s","target_os":"ubuntu26.04","architecture":"amd64","otp_version":"%s","elixir_version":"%s","node_version":"22.22.1","hex_version":"%s","rebar3_version":"%s"}\n' "$SOURCE_REVISION" "$OTP_VERSION" "$ELIXIR_VERSION" "$HEX_VERSION" "$REBAR3_VERSION" \
      > /artifact/toolchain.json

FROM scratch AS artifact
COPY --from=build /artifact/ /
