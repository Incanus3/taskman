    {
      "type": "frame",
      "id": "CmsvP",
      "x": 0,
      "y": 1700,
      "name": "04 Read me · Scope and handover",
      "clip": true,
      "width": 1184,
      "fill": "#0B1020",
      "layout": "vertical",
      "gap": 20,
      "padding": 36,
      "children": [
        {
          "type": "text",
          "id": "UUTPC",
          "name": "Handover heading",
          "fill": "#F1F5F9",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Task hierarchy design handover",
          "lineHeight": 1.2,
          "fontFamily": "Inter",
          "fontSize": 28,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "M4GJW1",
          "name": "Handover status",
          "fill": "#A5B4FC",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "VISUAL DESIGN APPROVED · BEHAVIOR SPECIFICATION DRAFT",
          "lineHeight": 1.2,
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "SB4ar",
          "name": "Pen file description",
          "fill": "#CBD5E1",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "This file defines the approved v2 task hierarchy and dialog Close placement. Use frames 01–03 for implementation. Frame 00 is the feature banner. Earlier explorations are retained below in the archive and are not implementation references.",
          "lineHeight": 1.2,
          "fontFamily": "Inter",
          "fontSize": 17,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "V6mLl",
          "name": "Preserved behavior",
          "fill": "#CBD5E1",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Preserve the full connected tree, URL-backed task navigation, autosave, comment-draft safeguards, and session-scoped expansion. Parentage remains editable through the existing form. Required ancestors and the selected task stay open; their downward chevrons are indicators, not collapse buttons.",
          "lineHeight": 1.2,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "ZKPQQ",
          "name": "Design boundary",
          "fill": "#CBD5E1",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The approved change covers tree readability, status metadata and a dedicated Close header. The rest of the editor is context: existing inputs, save feedback and discussion behavior remain authoritative. No search, drag-and-drop, reparenting controls or new task operations are introduced.",
          "lineHeight": 1.2,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "EUCuI",
          "name": "Freeze convention",
          "fill": "#CBD5E1",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Frozen visual baseline v2.1 · 2026-10-01. Narrow-open composition includes the dedicated dialog header. PNG exports and checksum manifest are the fixed reference. The .pen file remains editable; duplicate before further revisions.",
          "lineHeight": 1.2,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "D3tsP",
          "name": "Specification boundary",
          "fill": "#94A3B8",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The specification stays a local draft. Responsive breakpoints and deep-tree overflow remain proposed. New tree keyboard navigation is out of scope; preserve existing interaction and accessibility behavior. Open share-by-link access is accepted by the operator.",
          "lineHeight": 1.2,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        }
      ]
    },
